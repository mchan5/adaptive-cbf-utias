# Jetson (companion computer) — real flight, ROS 2 Humble, Livox MID-360.
export ARC_DEVICE=jetson
export ROS_DISTRO_EXPECTED=humble
export ARC_REGIME=hardware
export UAV_PREFIX=uav_0
export ARC_HAS_LIVOX=1

# Network / hardware specific — fill in on the Jetson AFTER setup.sh copies
# this to .arc-local.env (which is gitignored). Do not commit real values here.
export MOTIVE_PC_IP=CHANGE_ME
export THIS_MACHINE_IP=CHANGE_ME
export PIXHAWK_SERIAL_DEV=/dev/ttyTHS1
export PIXHAWK_BAUD=921600

# --- Wireless link to the ground station (ROS 2 Humble on both ends, domain 99) ---
export ROS_DOMAIN_ID=99
export ROS_LOCALHOST_ONLY=0
# Pin to the WiFi interface: this box also has l4tbr0 (192.168.55.1) and
# docker0, and letting Cyclone autodetect picks the wrong one.
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI="file://$ARC_ROOT/config/dds/cyclonedds_${ARC_DEVICE}.xml"
