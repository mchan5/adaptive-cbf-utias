# Laptop — SITL + field ground station, ROS 2 Humble in Docker (host is
# Ubuntu 24.04). Enter with scripts/dev.sh, build with scripts/build.sh.
export ARC_DEVICE=laptop
export ROS_DISTRO_EXPECTED=humble
export ARC_REGIME=sitl
export UAV_PREFIX=uav_0
export ARC_HAS_LIVOX=0

export MOTIVE_PC_IP=
export THIS_MACHINE_IP=
export PIXHAWK_SERIAL_DEV=
export PIXHAWK_BAUD=
