# Desktop — SITL development, ROS 2 Humble in Docker (host is Ubuntu 24.04).
# Use scripts/dev.sh to enter the container, then scripts/build.sh. No vehicle.
export ARC_DEVICE=desktop
export ROS_DISTRO_EXPECTED=humble
export ARC_REGIME=sitl
export UAV_PREFIX=uav_0
export ARC_HAS_LIVOX=0

# Unused in SITL, kept for a uniform env surface.
export MOTIVE_PC_IP=
export THIS_MACHINE_IP=
export PIXHAWK_SERIAL_DEV=
export PIXHAWK_BAUD=

# --- Wireless link to the Jetson (ROS 2 Humble on both ends, domain 99) ---
# Inside the Humble container the repo is bind-mounted at /ws, so the ARC_ROOT
# that setup.sh baked in (a host path) does not resolve there. Fix it first.
[ -d /ws ] && export ARC_ROOT=/ws
export ROS_DOMAIN_ID=99
export ROS_LOCALHOST_ONLY=0
# Multicast discovery is unreliable over WiFi and into WSL mirrored networking;
# the XML pins the interface and lists the peers explicitly instead.
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI="file://$ARC_ROOT/config/dds/cyclonedds_${ARC_DEVICE}.xml"
