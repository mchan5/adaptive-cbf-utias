<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arc_experiment_gui</name>
  <version>0.1.0</version>
  <description>
    Operator GUI for the adaptive-vs-fixed-gamma obstacle-avoidance campaign
    (see EXPERIMENT_GUI_PLAN_20260829.md). Launches, configures, runs, and
    logs trials against SITL and hardware through one interface. Never in the
    control path -- passive subscriber + occasional setup commands only.
  </description>
  <maintainer email="pizzaparty522@gmail.com">matthew</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>single_vehicle_cbf_rate_arc</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
